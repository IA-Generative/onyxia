# Variables d'environnement pour init-script-opencode.sh
# Copiez en .env et remplissez avec vos vraies valeurs

# Provider spark (optionnel)
API_KEY="sk-your-api-key-here"
API_URL="https://your-api-endpoint.example.com/ollama/v1"

# Provider infocepo-nothink (optionnel)
NOTHINK_API_KEY="your-nothink-api-key-here"
NOTHINK_API_URL="https://api-nothink.ailab.infocepo.com/v1"

# Au moins un des deux providers doit être configuré.
# ⚠️  Ne commitez jamais le fichier .env dans Git !
