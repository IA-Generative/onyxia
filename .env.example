# Exemple de configuration des variables d'environnement pour init-script-opencode.sh
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs

# ============================================
# PROVIDER SPARK (Recommandé)
# ============================================
# Clé API pour le provider Spark
# Obtenir une clé : contactez votre administrateur
SPARK_API_KEY="sk-your-spark-api-key-here"

# URL de l'API Spark (optionnel, valeur par défaut fournie)
SPARK_API_URL="https://your-spark-api-endpoint.example.com/v1"

# ============================================
# PROVIDER GITHUB (Optionnel)
# ============================================
# Token GitHub pour GitHub Models et GitHub CLI
# Obtenir un token : https://github.com/settings/tokens/new
# Permissions requises :
#   - repo (Full control of private repositories)
#   - workflow (Update GitHub Action workflows)
#   - read:org (Read org and team membership)
#   - read:project (Read access to projects)
GITHUB_TOKEN="github_pat_your_github_token_here"

# URL de l'API GitHub Models (optionnel, valeur par défaut fournie)
GITHUB_API_URL="https://models.github.com"

# ============================================
# CONFIGURATION OPENCODE (Optionnel)
# ============================================
# Version d'OpenCode à installer (latest par défaut)
# OPENCODE_VERSION="latest"
# OPENCODE_VERSION="1.15.10"

# Répertoire d'installation d'OpenCode
# OPENCODE_INSTALL_DIR="$HOME/.opencode"

# Répertoire de travail pour la configuration
# WORK_DIR="$HOME/work"

# ============================================
# UTILISATION
# ============================================
# 1. Copiez ce fichier :
#    cp .env.example .env
#
# 2. Éditez .env avec vos vraies valeurs :
#    nano .env
#
# 3. Chargez les variables :
#    source .env
#
# 4. Exécutez le script :
#    ./init-script-opencode.sh
#
# ⚠️  IMPORTANT : Ne commitez jamais le fichier .env dans Git !
#    Ajoutez-le à .gitignore
